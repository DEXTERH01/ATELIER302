<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ATELIER_TOBE" targetNamespace="https://atelier.pe/bpmn">
  <bpmn:message id="Message_Request" name="Request"/>
  <bpmn:message id="Message_AcceptQuote" name="AcceptQuote"/>
  <bpmn:message id="Message_RejectQuote" name="RejectQuote"/>
  <bpmn:message id="Message_Payment" name="Payment"/>
  <bpmn:message id="Message_Study" name="Study"/>
  <bpmn:message id="Message_Conformity" name="Conformity"/>
  <bpmn:message id="Message_AdditionalPayment" name="AdditionalPayment"/>
  <bpmn:message id="Message_EntityResponse" name="EntityResponse"/>
  <bpmn:collaboration id="Collaboration_ATELIER">
    <bpmn:participant id="Participant_Client" name="Cliente"/>
    <bpmn:participant id="Participant_ATELIER" name="Gestión Digital de Proyectos ATELIER" processRef="Process_ATELIER_TOBE"/>
    <bpmn:participant id="Participant_Entity" name="Entidad pública"/>
    <bpmn:messageFlow id="MF01" name="Enviar solicitud" sourceRef="Participant_Client" targetRef="Start_Request"/>
    <bpmn:messageFlow id="MF02" name="Cotización" sourceRef="Task_SendQuote" targetRef="Participant_Client"/>
    <bpmn:messageFlow id="MF03" name="Aceptación" sourceRef="Participant_Client" targetRef="Event_AcceptQuote"/>
    <bpmn:messageFlow id="MF04" name="Rechazo" sourceRef="Participant_Client" targetRef="Event_RejectQuote"/>
    <bpmn:messageFlow id="MF05" name="Comprobante" sourceRef="Participant_Client" targetRef="Event_Payment"/>
    <bpmn:messageFlow id="MF06" name="Solicitud de corrección" sourceRef="Task_RequestCorrection" targetRef="Participant_Client"/>
    <bpmn:messageFlow id="MF07" name="Solicitud de estudio" sourceRef="Task_RequestStudy" targetRef="Participant_Client"/>
    <bpmn:messageFlow id="MF08" name="Estudio técnico" sourceRef="Participant_Client" targetRef="Event_Study"/>
    <bpmn:messageFlow id="MF09" name="Avance del diseño" sourceRef="Task_SendDesign" targetRef="Participant_Client"/>
    <bpmn:messageFlow id="MF10" name="Conformidad u observaciones" sourceRef="Participant_Client" targetRef="Event_Conformity"/>
    <bpmn:messageFlow id="MF11" name="Cotización adicional" sourceRef="Task_AdditionalQuote" targetRef="Participant_Client"/>
    <bpmn:messageFlow id="MF12" name="Pago adicional" sourceRef="Participant_Client" targetRef="Event_AdditionalPayment"/>
    <bpmn:messageFlow id="MF13" name="Expediente" sourceRef="Task_SubmitProcedure" targetRef="Participant_Entity"/>
    <bpmn:messageFlow id="MF14" name="Respuesta u observaciones" sourceRef="Participant_Entity" targetRef="Event_EntityResponse"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_ATELIER_TOBE" name="TO-BE Gestión Digital de Proyectos ATELIER" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ATELIER">
      <bpmn:lane id="Lane_System" name="Sistema Gestión ATELIER"><bpmn:flowNodeRef>Task_RequestDocs</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SendQuote</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_WaitQuote</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_AcceptQuote</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_RejectQuote</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_QuoteExpired</bpmn:flowNodeRef><bpmn:flowNodeRef>End_QuoteRejected</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_Payment</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RequestCorrection</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ActivateProject</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RequestStudy</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_Study</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SendDesign</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_Conformity</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdditionalQuote</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_AdditionalPayment</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_EntityResponse</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Encargado del proyecto"><bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Complete</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Classify</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Quote</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DecideRenew</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Renew</bpmn:flowNodeRef><bpmn:flowNodeRef>End_QuoteClosed</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidatePayment</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_PaymentValid</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Plan</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Study</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidateStudy</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AssignSpecialties</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Consolidate</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Conform</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Changes</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Modify</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidateAdditional</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FinalFile</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Public</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DeliverDirect</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Delivered</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SubmitProcedure</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Observed</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Fix</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AttachResolution</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FinalDelivery</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Approved</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NotViable</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Specialist" name="Especialistas internos / externos"><bpmn:flowNodeRef>Task_DevelopSpecialties</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Request" name="Solicitud de proyecto recibida"><bpmn:messageEventDefinition messageRef="Message_Request"/></bpmn:startEvent>
    <bpmn:userTask id="Task_Register" name="Registrar cliente, predio y requerimiento"/>
    <bpmn:exclusiveGateway id="Gateway_Complete" name="¿Información completa?"/>
    <bpmn:sendTask id="Task_RequestDocs" name="Solicitar documentos faltantes"/>
    <bpmn:userTask id="Task_Classify" name="Clasificar tipo y complejidad"/>
    <bpmn:userTask id="Task_Quote" name="Elaborar cotización"/>
    <bpmn:sendTask id="Task_SendQuote" name="Enviar cotización y registrar vigencia"/>
    <bpmn:eventBasedGateway id="Gateway_WaitQuote" name="Esperar respuesta (10 días)"/>
    <bpmn:intermediateCatchEvent id="Event_AcceptQuote" name="Cotización aceptada"><bpmn:messageEventDefinition messageRef="Message_AcceptQuote"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_RejectQuote" name="Cotización rechazada"><bpmn:messageEventDefinition messageRef="Message_RejectQuote"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_QuoteExpired" name="Vencimiento: 10 días"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_DecideRenew" name="Evaluar renovación de cotización"/>
    <bpmn:exclusiveGateway id="Gateway_Renew" name="¿Renovar?"/>
    <bpmn:endEvent id="End_QuoteClosed" name="Cotización cerrada"/>
    <bpmn:endEvent id="End_QuoteRejected" name="Cotización no aceptada"/>
    <bpmn:intermediateCatchEvent id="Event_Payment" name="Comprobante de pago recibido"><bpmn:messageEventDefinition messageRef="Message_Payment"/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_ValidatePayment" name="Validar pago"/>
    <bpmn:exclusiveGateway id="Gateway_PaymentValid" name="¿Pago válido?"/>
    <bpmn:sendTask id="Task_RequestCorrection" name="Solicitar corrección del pago"/>
    <bpmn:serviceTask id="Task_ActivateProject" name="Crear código y expediente digital"/>
    <bpmn:userTask id="Task_Plan" name="Planificar visita y actividades"/>
    <bpmn:exclusiveGateway id="Gateway_Study" name="¿Requiere estudio técnico?"/>
    <bpmn:sendTask id="Task_RequestStudy" name="Solicitar estudio de suelo o topografía"/>
    <bpmn:intermediateCatchEvent id="Event_Study" name="Estudio técnico recibido"><bpmn:messageEventDefinition messageRef="Message_Study"/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_ValidateStudy" name="Validar estudio técnico"/>
    <bpmn:userTask id="Task_AssignSpecialties" name="Asignar especialidades y responsables"/>
    <bpmn:userTask id="Task_DevelopSpecialties" name="Desarrollar y subir especialidades"/>
    <bpmn:userTask id="Task_Consolidate" name="Consolidar diseño preliminar"/>
    <bpmn:sendTask id="Task_SendDesign" name="Enviar avance para conformidad"/>
    <bpmn:intermediateCatchEvent id="Event_Conformity" name="Respuesta del cliente recibida"><bpmn:messageEventDefinition messageRef="Message_Conformity"/></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Conform" name="¿Cliente conforme?"/>
    <bpmn:exclusiveGateway id="Gateway_Changes" name="¿Más de dos cambios?"/>
    <bpmn:userTask id="Task_Modify" name="Modificar diseño según observaciones"/>
    <bpmn:sendTask id="Task_AdditionalQuote" name="Generar cotización adicional"/>
    <bpmn:intermediateCatchEvent id="Event_AdditionalPayment" name="Pago adicional recibido"><bpmn:messageEventDefinition messageRef="Message_AdditionalPayment"/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_ValidateAdditional" name="Validar pago adicional"/>
    <bpmn:userTask id="Task_FinalFile" name="Generar expediente final"/>
    <bpmn:exclusiveGateway id="Gateway_Public" name="¿Requiere trámite público?"/>
    <bpmn:userTask id="Task_DeliverDirect" name="Entregar expediente final"/>
    <bpmn:endEvent id="End_Delivered" name="Proyecto entregado y cerrado"/>
    <bpmn:sendTask id="Task_SubmitProcedure" name="Registrar y enviar trámite"/>
    <bpmn:intermediateCatchEvent id="Event_EntityResponse" name="Respuesta de la entidad recibida"><bpmn:messageEventDefinition messageRef="Message_EntityResponse"/></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Observed" name="¿Tiene observaciones?"/>
    <bpmn:userTask id="Task_Fix" name="Subsanar observaciones"/>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="¿Trámite aprobado?"/>
    <bpmn:userTask id="Task_AttachResolution" name="Adjuntar resolución o licencia"/>
    <bpmn:userTask id="Task_FinalDelivery" name="Entregar proyecto aprobado"/>
    <bpmn:endEvent id="End_Approved" name="Proyecto aprobado y cerrado"/>
    <bpmn:endEvent id="End_NotViable" name="Trámite no viable"/>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Request" targetRef="Task_Register"/>
    <bpmn:sequenceFlow id="F02" sourceRef="Task_Register" targetRef="Gateway_Complete"/>
    <bpmn:sequenceFlow id="F03" name="No" sourceRef="Gateway_Complete" targetRef="Task_RequestDocs"/>
    <bpmn:sequenceFlow id="F04" name="Documentos recibidos" sourceRef="Task_RequestDocs" targetRef="Task_Register"/>
    <bpmn:sequenceFlow id="F05" name="Sí" sourceRef="Gateway_Complete" targetRef="Task_Classify"/>
    <bpmn:sequenceFlow id="F06" sourceRef="Task_Classify" targetRef="Task_Quote"/>
    <bpmn:sequenceFlow id="F07" sourceRef="Task_Quote" targetRef="Task_SendQuote"/>
    <bpmn:sequenceFlow id="F08" sourceRef="Task_SendQuote" targetRef="Gateway_WaitQuote"/>
    <bpmn:sequenceFlow id="F09" name="Acepta" sourceRef="Gateway_WaitQuote" targetRef="Event_AcceptQuote"/>
    <bpmn:sequenceFlow id="F10" name="Rechaza" sourceRef="Gateway_WaitQuote" targetRef="Event_RejectQuote"/>
    <bpmn:sequenceFlow id="F11" name="Vence" sourceRef="Gateway_WaitQuote" targetRef="Event_QuoteExpired"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Event_RejectQuote" targetRef="End_QuoteRejected"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Event_QuoteExpired" targetRef="Task_DecideRenew"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_DecideRenew" targetRef="Gateway_Renew"/>
    <bpmn:sequenceFlow id="F15" name="Sí" sourceRef="Gateway_Renew" targetRef="Task_Quote"/>
    <bpmn:sequenceFlow id="F16" name="No" sourceRef="Gateway_Renew" targetRef="End_QuoteClosed"/>
    <bpmn:sequenceFlow id="F17" sourceRef="Event_AcceptQuote" targetRef="Event_Payment"/>
    <bpmn:sequenceFlow id="F18" sourceRef="Event_Payment" targetRef="Task_ValidatePayment"/>
    <bpmn:sequenceFlow id="F19" sourceRef="Task_ValidatePayment" targetRef="Gateway_PaymentValid"/>
    <bpmn:sequenceFlow id="F20" name="No" sourceRef="Gateway_PaymentValid" targetRef="Task_RequestCorrection"/>
    <bpmn:sequenceFlow id="F21" name="Comprobante corregido" sourceRef="Task_RequestCorrection" targetRef="Event_Payment"/>
    <bpmn:sequenceFlow id="F22" name="Sí" sourceRef="Gateway_PaymentValid" targetRef="Task_ActivateProject"/>
    <bpmn:sequenceFlow id="F23" sourceRef="Task_ActivateProject" targetRef="Task_Plan"/>
    <bpmn:sequenceFlow id="F24" sourceRef="Task_Plan" targetRef="Gateway_Study"/>
    <bpmn:sequenceFlow id="F25" name="Sí" sourceRef="Gateway_Study" targetRef="Task_RequestStudy"/>
    <bpmn:sequenceFlow id="F26" sourceRef="Task_RequestStudy" targetRef="Event_Study"/>
    <bpmn:sequenceFlow id="F27" sourceRef="Event_Study" targetRef="Task_ValidateStudy"/>
    <bpmn:sequenceFlow id="F28" name="Estudio válido" sourceRef="Task_ValidateStudy" targetRef="Task_AssignSpecialties"/>
    <bpmn:sequenceFlow id="F29" name="No" sourceRef="Gateway_Study" targetRef="Task_AssignSpecialties"/>
    <bpmn:sequenceFlow id="F30" sourceRef="Task_AssignSpecialties" targetRef="Task_DevelopSpecialties"/>
    <bpmn:sequenceFlow id="F31" name="Especialidades completas" sourceRef="Task_DevelopSpecialties" targetRef="Task_Consolidate"/>
    <bpmn:sequenceFlow id="F32" sourceRef="Task_Consolidate" targetRef="Task_SendDesign"/>
    <bpmn:sequenceFlow id="F33" sourceRef="Task_SendDesign" targetRef="Event_Conformity"/>
    <bpmn:sequenceFlow id="F34" sourceRef="Event_Conformity" targetRef="Gateway_Conform"/>
    <bpmn:sequenceFlow id="F35" name="Sí" sourceRef="Gateway_Conform" targetRef="Task_FinalFile"/>
    <bpmn:sequenceFlow id="F36" name="No" sourceRef="Gateway_Conform" targetRef="Gateway_Changes"/>
    <bpmn:sequenceFlow id="F37" name="No" sourceRef="Gateway_Changes" targetRef="Task_Modify"/>
    <bpmn:sequenceFlow id="F38" name="Nueva versión" sourceRef="Task_Modify" targetRef="Task_SendDesign"/>
    <bpmn:sequenceFlow id="F39" name="Sí" sourceRef="Gateway_Changes" targetRef="Task_AdditionalQuote"/>
    <bpmn:sequenceFlow id="F40" sourceRef="Task_AdditionalQuote" targetRef="Event_AdditionalPayment"/>
    <bpmn:sequenceFlow id="F41" sourceRef="Event_AdditionalPayment" targetRef="Task_ValidateAdditional"/>
    <bpmn:sequenceFlow id="F42" name="Pago confirmado" sourceRef="Task_ValidateAdditional" targetRef="Task_Modify"/>
    <bpmn:sequenceFlow id="F43" sourceRef="Task_FinalFile" targetRef="Gateway_Public"/>
    <bpmn:sequenceFlow id="F44" name="No" sourceRef="Gateway_Public" targetRef="Task_DeliverDirect"/>
    <bpmn:sequenceFlow id="F45" sourceRef="Task_DeliverDirect" targetRef="End_Delivered"/>
    <bpmn:sequenceFlow id="F46" name="Sí" sourceRef="Gateway_Public" targetRef="Task_SubmitProcedure"/>
    <bpmn:sequenceFlow id="F47" sourceRef="Task_SubmitProcedure" targetRef="Event_EntityResponse"/>
    <bpmn:sequenceFlow id="F48" sourceRef="Event_EntityResponse" targetRef="Gateway_Observed"/>
    <bpmn:sequenceFlow id="F49" name="Sí" sourceRef="Gateway_Observed" targetRef="Task_Fix"/>
    <bpmn:sequenceFlow id="F50" name="Reenviar" sourceRef="Task_Fix" targetRef="Task_SubmitProcedure"/>
    <bpmn:sequenceFlow id="F51" name="No" sourceRef="Gateway_Observed" targetRef="Gateway_Approved"/>
    <bpmn:sequenceFlow id="F52" name="Sí" sourceRef="Gateway_Approved" targetRef="Task_AttachResolution"/>
    <bpmn:sequenceFlow id="F53" sourceRef="Task_AttachResolution" targetRef="Task_FinalDelivery"/>
    <bpmn:sequenceFlow id="F54" sourceRef="Task_FinalDelivery" targetRef="End_Approved"/>
    <bpmn:sequenceFlow id="F55" name="No" sourceRef="Gateway_Approved" targetRef="End_NotViable"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ATELIER">
    <bpmndi:BPMNPlane id="BPMNPlane_ATELIER" bpmnElement="Collaboration_ATELIER">
